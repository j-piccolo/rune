+/// A flex item's resolved minimum main size: known, or an automatic minimum (`min-width: auto` in
+/// a row, 4.5) not measured yet.
+///
+/// The automatic minimum is the item's min-content main size, clamped by its main size and its
+/// transferred max main size and floored by its padding and border. Measuring it means laying
+/// out the item's whole subtree at min-content, and when the item's main size is definite its
+/// result is mostly unused: the minimum is then at most that size, so it only holds the item when
+/// its line shrinks. Such a minimum is left [`ResolvedMinimum::Deferred`] with the range it lies
+/// in, and each step that reads it (`FlexItem::with_minimum`), all monotone in it, measures it
+/// only if its result differs at the two ends of that range. Debug builds measure it up front as
+/// well and check each such step against it.
+#[derive(Debug, Clone, Copy)]
+enum ResolvedMinimum {
+    /// The resolved minimum main size.
+    Known(f32),
+    /// An automatic minimum not measured yet.
+    Deferred(AutoMinimum),
+}
+
+/// An automatic minimum main size not measured yet: the range it lies in, and how
+/// `determine_flex_base_size` would have measured it (the container's sizes change after it).
+#[derive(Debug, Clone, Copy)]
+struct AutoMinimum {
+    /// The minimum lies in `lo..=hi`: the clamp at min-content sizes of minus and plus infinity.
+    lo: f32,
+    hi: f32,
+    known_dimensions: Size<Option<f32>>,
+    parent_size: Size<Option<f32>>,
+    available_space: Size<AvailableSpace>,
+    /// The item's main size and transferred max main size, which clamp the min-content size, and
+    /// its main padding and border, which floor it.
+    size: Option<f32>,
+    max_size: Option<f32>,
+    padding_border: Option<f32>,
+    /// Measured up front in debug builds, to check every step that doesn't measure it.
+    #[cfg(debug_assertions)]
+    eager: f32,
+}
+
+impl AutoMinimum {
+    /// 4.5. Automatic Minimum Size of Flex Items: the min-content main size, clamped and floored.
+    /// <https://www.w3.org/TR/css-flexbox-1/#min-size-auto>
+    fn clamp(&self, min_content_main_size: f32) -> f32 {
+        let clamped_min_content_size = min_content_main_size.maybe_min(self.size).maybe_min(self.max_size);
+        clamped_min_content_size.maybe_max(self.padding_border)
+    }
+
+    fn measure(&self, tree: &mut impl LayoutFlexboxContainer, node: NodeId, dir: FlexDirection) -> f32 {
+        debug_log!("COMPUTE CHILD MIN SIZE:");
+        let min_content_main_size = tree.measure_child_size(
+            node,
+            self.known_dimensions,
+            self.parent_size,
+            self.available_space,
+            SizingMode::ContentSize,
+            dir.main_axis(),
+            Line::FALSE,
+        );
+        self.clamp(min_content_main_size)
+    }
+
+    /// Checks, in debug builds, that a step which skipped measuring the minimum got what it would
+    /// have with it measured.
+    #[cfg(debug_assertions)]
+    fn check(&self, with_minimum: f32, unmeasured: f32) {
+        debug_assert_eq!(
+            with_minimum.to_bits(),
+            unmeasured.to_bits(),
+            "a flex item's unmeasured automatic minimum {} in {}..={} changed a step's result: {} measured, {} not",
+            self.eager,
+            self.lo,
+            self.hi,
+            with_minimum,
+            unmeasured
+        );
+    }
+}
